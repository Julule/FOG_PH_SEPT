  m_Script: {fileID: 11500000, guid: 70f99bdbd3c28b544b222382a6078de6, type: 3}
  m_Name: Chap1Matt
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 0ac9cd38d430efc46bc9e72f02bd7c8e, type: 2}
    text: "Excusez-moi, vous \xEAtes le m\xE9canicien de ce train ?"
  - speaker: {fileID: 11400000, guid: bc97b4d31f91a8a4fad3810dda95572b, type: 2}
    text: "Oui, malheureusement, c'est bien moi J'imagine que tu te demande ce qui
      se passe.. Je ne sais pas, \xE0 vrai dire ! "
  options:
  - optionType: 0
    optionText: "Tu n'as rien trouv\xE9 du tout ? "
    nextDialogue: {fileID: 11400000, guid: 2410f0399e5450949846bfc44229fcee, type: 2}
    clue: "La probl\xE8me n'a pas l'air m\xE9canique.. "
  - optionType: 1
    optionText: "J'imagine que vous n'avez pas encore d'id\xE9e de la cause du probl\xE8me.
      Ces deux caisses ici sont \xE0 vous ?"
    nextDialogue: {fileID: 11400000, guid: 03b9628436db5f7488e8f114afd0f014, type: 2}
    clue: Matt est assez protecteur du chargement de la cabine
