  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 70f99bdbd3c28b544b222382a6078de6, type: 3}
  m_Name: Chap1Prune
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 0ac9cd38d430efc46bc9e72f02bd7c8e, type: 2}
    text: "Excusez-moi, c'est pas la m\xE9ga panique, l\xE0 ? Je suis la seule \xE0
      essayer de comprendre ?"
  - speaker: {fileID: 11400000, guid: fa46dc0c299928f409df11c3c498c33d, type: 2}
    text: "Oh n'en rajoute pas, j'ai d\xE9j\xE0 du mal \xE0 faire mes exercices de
      respiration pour me calmer "
  options:
  - optionType: 1
    optionText: "J'ai du mal \xE0 comprendre ce qui se passe, et les personnes en
      charge n'ont pas l'air de comprendre elles-m\xEAmes.."
    nextDialogue: {fileID: 11400000, guid: 86a5360d76c718347b6a9fb268de15a0, type: 2}
    clue: "Matt n'as pas trop envie de discuter de ses activit\xE9s."
  - optionType: 0
    optionText: "Vous avez l'air tr\xE8s mal \xE0 l'aise.. "
    nextDialogue: {fileID: 11400000, guid: 11edab9f8ddfdbd46864c1d9bfcd6faf, type: 2}
    clue: "Prune a d\xE9j\xE0 crois\xE9 Cl\xE9lia quelque part."
