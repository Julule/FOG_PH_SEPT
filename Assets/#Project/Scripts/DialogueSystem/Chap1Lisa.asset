  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 70f99bdbd3c28b544b222382a6078de6, type: 3}
  m_Name: Chap1Lisa
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 0ac9cd38d430efc46bc9e72f02bd7c8e, type: 2}
    text: "Ah, je vous cherchai.. Selon le m\xE9canicien, le moteur ne serait peut-\xEAtre
      pas la cause du probl\xE8me."
  - speaker: {fileID: 11400000, guid: f81fbeda897bd354fa190101f40cc7ad, type: 2}
    text: "Ah bon ? Tiens, c\u2019est bizarre. Je ne sais pas, je ne m\u2019occupe
      pas du tout de technique.. Vous en avez parl\xE9 \xE0 Cl\xE9lia ?"
  options:
  - optionType: 0
    optionText: Je peux lui faire confiance ?
    nextDialogue: {fileID: 11400000, guid: cdfbcf90b2741cb41afc4b17bd3b36d7, type: 2}
    clue: "Cl\xE9lia est hackeuse"
  - optionType: 1
    optionText: "La passag\xE8re qui part en vacances chez sa soeur ?"
    nextDialogue: {fileID: 11400000, guid: c5d4bbbb62f0aa846a1ec72c8adf1123, type: 2}
    clue: "Tableau de bord : 14:17 // Info Service : Proc\xE9dure de routine\r\n:
      Inspection du chargement par la douane \xE0 l\u2019arriv\xE9e"
